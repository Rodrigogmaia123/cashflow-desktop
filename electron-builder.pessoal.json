{
  "appId": "pro.cashflow.desktop.pessoal",
  "productName": "Cashflow Pessoal",
  "copyright": "Cashflow Pessoal",
  "asar": true,
  "files": [
    "electron/main.cjs",
    "electron/preload.cjs",
    "electron/icon.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist/pack-server",
      "to": "app-server"
    },
    {
      "from": "electron/resources/empty.db",
      "to": "empty.db"
    },
    {
      "from": "electron/resources/edition-pessoal.json",
      "to": "edition.json"
    }
  ],
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "icon": "build/icon.png",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "Cashflow-Pessoal-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["universal"]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.finance",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "identity": null,
    "artifactName": "Cashflow-Pessoal-Setup-${version}.${ext}"
  },
  "dmg": {
    "title": "${productName} ${version}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "electron/installer.nsh",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Cashflow Pessoal",
    "uninstallDisplayName": "Cashflow Pessoal"
  }
}
