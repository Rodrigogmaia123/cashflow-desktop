{
  "name": "cashflow-pro",
  "version": "0.1.6",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3456 -H 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.cjs",
    "start:web": "node scripts/start.cjs",
    "desktop": "electron ./electron/main.cjs",
    "desktop:pessoal": "node scripts/run-desktop-pessoal.cjs",
    "desktop:build": "node scripts/build-desktop.cjs",
    "desktop:build:pro": "node scripts/ensure-empty-db.cjs && next build && node scripts/prepare-desktop-build.cjs && electron-builder --win nsis && node scripts/clean-stale-installers.cjs && node scripts/publish-installers.cjs",
    "desktop:build:pessoal": "node scripts/ensure-empty-db.cjs && next build && node scripts/prepare-desktop-build.cjs && electron-builder --config electron-builder.pessoal.json --win nsis && node scripts/clean-stale-installers.cjs && node scripts/publish-installers.cjs",
    "desktop:portable": "node scripts/make-portable-with-my-data.cjs",
    "desktop:import": "tsx scripts/import-from-production.ts",
    "desktop:import:list": "tsx scripts/import-from-production.ts --list-users",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test:email": "tsx scripts/test-email.ts",
    "test:budgets": "tsx scripts/test-budgets.ts",
    "fix:foreign-keys": "tsx scripts/fix-foreign-key-constraint.ts",
    "fix:foreign-keys-direct": "tsx scripts/fix-foreign-key-direct.ts",
    "verify:prisma": "tsx scripts/verify-prisma-client.ts",
    "fix:prisma": "tsx scripts/fix-all-prisma-issues.ts",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:reset:seed": "tsx scripts/reset-database.ts --seed",
    "reset:db": "tsx scripts/reset-database.ts",
    "reset:db:seed": "tsx scripts/reset-database.ts --seed"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "driver.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.0.10",
    "next-auth": "^4.24.5",
    "nodemailer": "^7.0.11",
    "pg": "^8.23.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-email": "^5.1.0",
    "recharts": "^2.15.4",
    "resend": "^6.6.0",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.18",
    "dotenv-cli": "^11.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.10",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "puppeteer": "^24.34.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "pro.cashflow.desktop",
    "productName": "Cashflow Pro",
    "copyright": "Cashflow Pro",
    "asar": true,
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/pack-server",
        "to": "app-server"
      },
      {
        "from": "electron/resources/empty.db",
        "to": "empty.db"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cashflow-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "electron/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cashflow Pro",
      "uninstallDisplayName": "Cashflow Pro"
    }
  }
}
